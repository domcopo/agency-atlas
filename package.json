{
  "name": "agency-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Internal agency command center. Phase 1: mock data only, no live connections.",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3200",
    "dev:phone": "node scripts/guard-phone.mjs && next dev -H 0.0.0.0 -p 3200",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3200",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:rls": "node scripts/test-rls.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}

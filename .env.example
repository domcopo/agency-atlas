# Agency Atlas — environment variable NAMES only. Never put real values in this file.
#
# How to use: create a file named .env.local in this folder (Git ignores it) and put
# the real values there. Claude never opens .env.local.
#
# Rules:
# - These have NO "NEXT_PUBLIC_" prefix on purpose, so they stay on the server.
# - Use the PUBLISHABLE key (starts with sb_publishable_). Never the secret key
#   (sb_secret_...) or the old "service_role" key: those bypass database security.
#   The app refuses to start in database mode if you paste one by mistake.

# --- Phase 2: Supabase (the NEW project made only for Agency Atlas) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Phase 3: GoHighLevel, READ-ONLY (the agency's own sub-account) ---
# A Private Integration token (starts with pit-) created with ONLY .readonly scopes:
# opportunities.readonly, calendars.readonly, calendars/events.readonly, locations.readonly
GHL_READONLY_TOKEN=
GHL_LOCATION_ID=

# --- Phase 4: AI (Anthropic). Server only. Set a monthly spend limit in the Anthropic Console too. ---
ANTHROPIC_API_KEY=

# --- Owner summary (0012): your personal dashboard reads GET /api/owner-summary ---
# The SHA-256 FINGERPRINT of the dashboard's key (64 hex characters), not the key.
# Empty = the route is off (404). The key itself lives only in the dashboard's settings.
OWNER_SUMMARY_TOKEN_SHA256=

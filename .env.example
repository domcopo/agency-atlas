# Agency Atlas — environment variable NAMES only. Never put real values in this file.
# Phase 1 (mock data) needs NO environment variables at all.
#
# How to use later: copy this file to .env.local on the server/host only,
# fill values there, and never commit it (.gitignore blocks it).
#
# Rules:
# - Anything starting with NEXT_PUBLIC_ is sent to every browser. Never put a secret in one.
# - Service-role / secret keys bypass database security. Server-only, never in the browser.

# --- Phase 2: Supabase (separate DEVELOPMENT project only) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Phase 3: GoHighLevel read-only pilot (ONE test sub-account, .readonly scopes only) ---
# GHL_TEST_LOCATION_ID=
# GHL_READONLY_TOKEN=
